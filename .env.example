# .env 로 복사한 뒤 값을 채우세요. .env 는 git에 올라가지 않습니다.

# 실행 모드: backtest | paper | live  (기본은 paper — live는 명시적으로 바꿀 때만)
TRADING_MODE=paper

# ── 한국투자증권 OpenAPI ──
# 모의투자와 실전투자는 앱키/계좌가 다릅니다. 따로 관리하세요.
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=
KIS_PAPER_ACCOUNT_NO=        # 계좌번호 앞 8자리
KIS_PAPER_ACCOUNT_PROD=01    # 상품코드 뒤 2자리

KIS_LIVE_APP_KEY=
KIS_LIVE_APP_SECRET=
KIS_LIVE_ACCOUNT_NO=
KIS_LIVE_ACCOUNT_PROD=01

# ── Binance ──
# 테스트넷 키는 testnet.binance.vision (현물) / testnet.binancefuture.com (선물) 에서 별도 발급
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
BINANCE_LIVE_API_KEY=        # 출금 권한은 반드시 끄고, IP 화이트리스트 설정
BINANCE_LIVE_API_SECRET=

# ── Upbit (김치 프리미엄 비교용 — 처음에는 시세 조회만 하므로 키 불필요) ──
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=

# ── Alpaca (미국 1분봉 2016~ 수집용, 모의투자 계정 키로 충분 · 주문에는 쓰지 않음) ──
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# ── NAVER API HUB (네이버 클라우드, 검색어 트렌드·뉴스 검색 수집용) ──
# 헤더 X-NCP-APIGW-API-KEY-ID / X-NCP-APIGW-API-KEY 로 보낸다. "한시적 무료, 유료 전환 시 사전 공지"
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 알림 (선택) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
