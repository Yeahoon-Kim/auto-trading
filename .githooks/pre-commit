#!/bin/sh
# master(main)에 직접 커밋하지 못하게 막는다. 작업은 브랜치(작업 폴더)에서 커밋하고 병합한다.
# 병합(git merge)으로 생기는 커밋은 이 훅을 거치지 않는다. 충돌을 풀고 직접 커밋할 때만 걸린다.
# 사용자가 꼭 필요할 때만: ALLOW_MASTER_COMMIT=1 git commit ...
branch=$(git symbolic-ref --short -q HEAD)
if [ "$branch" = "master" ] || [ "$branch" = "main" ]; then
  if [ "$ALLOW_MASTER_COMMIT" != "1" ]; then
    echo "[pre-commit] $branch에 직접 커밋할 수 없습니다." >&2
    echo "  브랜치에서 커밋한 뒤 병합하세요: git switch -c <브랜치> (또는 작업 폴더에서 작업)" >&2
    echo "  꼭 필요하면 사용자가 직접: ALLOW_MASTER_COMMIT=1 git commit ..." >&2
    exit 1
  fi
fi
exit 0
